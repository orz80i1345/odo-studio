# 真實 API
VITE_API_BASE_URL=https://cv3op1ht.cgapps.dev/api
VITE_API_KEY=

# 信箱驗證 Pages Function 的網址。正式環境與前端同網域時保持空白。
# 本機 Vite 開發時可填入已部署的 Pages 網址。
VITE_EMAIL_VERIFICATION_BASE_URL=

# LINE Login / LIFF
VITE_LINE_LIFF_ID=
# 例如 /workflow/{workflow_id}/execute，由 server-side workflow 驗證 LINE token 後寫入 customer_line_accounts
VITE_LINE_LINK_ENDPOINT=

# 只有本機需要假資料時才打開
# VITE_USE_MOCK=true
